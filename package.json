{
	"name": "n8n-nodes-stac",
	"version": "0.1.0",
	"description": "Nodes n8n para a Stac: modelos open-source com preço fixo mensal",
	"license": "MIT",
	"homepage": "https://trystac.com",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"stac",
		"llm",
		"ai"
	],
	"author": {
		"name": "Diogo Chiapeta",
		"email": "diogo@trystac.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Dchiapeta/n8n_stac_node.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"aiNodeSdkVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/StacApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/LmChatStac/LmChatStac.node.js"
		]
	},
	"devDependencies": {
		"@n8n/ai-node-sdk": "0.26.6",
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"n8n-workflow": "2.36.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*",
		"@n8n/ai-node-sdk": "*"
	},
	"bugs": {
		"url": "https://github.com/Dchiapeta/n8n_stac_node/issues"
	}
}
